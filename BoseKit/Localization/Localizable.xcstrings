    "connection.help" : {
      "comment" : "Connection interface label or message: help.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Make sure your device is on and within Bluetooth range of your Mac."
