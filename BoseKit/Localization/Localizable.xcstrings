    "connection.refreshHelp" : {
      "comment" : "Connection interface label or message: refreshHelp.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "While this view is open, settings refresh periodically to reflect changes from other apps or headphone buttons."
