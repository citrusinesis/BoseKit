    "connection.discoveryHelp" : {
      "comment" : "Connection interface label or message: discoveryHelp.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "BoseKit shows supported paired devices and automatically connects to devices available over Bluetooth."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "BoseKit은 페어링된 지원 기기를 표시하고, Bluetooth로 연결할 수 있는 기기에 자동으로 연결합니다."
          }
        }
      }
    },
    "connection.emptyHelp" : {
      "comment" : "Connection interface label or message: emptyHelp.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pair a supported Bose device in macOS Bluetooth settings to see it here."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS Bluetooth 설정에서 지원되는 Bose 기기를 페어링하면 여기에 표시됩니다."
          }
        }
      }
    },
    "connection.emptyTitle" : {
      "comment" : "Connection interface label or message: emptyTitle.",
